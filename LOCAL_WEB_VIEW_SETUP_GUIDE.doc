<title>SecureU — Local Web View Setup & Execution Guide</title>
<style>
body { font-family: Calibri, Arial, sans-serif; line-height: 1.5; color: #1e293b; margin: 35px; }
h1 { color: #0f172a; border-bottom: 2px solid #0f172a; padding-bottom: 8px; font-size: 24pt; }
h2 { color: #1e293b; border-bottom: 1px solid #cbd5e1; padding-bottom: 5px; margin-top: 24px; font-size: 15pt; }
code, pre { font-family: Consolas, 'Courier New', monospace; background: #f1f5f9; padding: 3px 6px; border-radius: 4px; }
pre { background: #0f172a; color: #f8fafc; padding: 14px; border-radius: 6px; overflow-x: auto; font-size: 10pt; }
table { border-collapse: collapse; width: 100%; margin: 15px 0; }
